@model IEnumerable<SmartFitGym.Models.MembershipPlan>
@{
    ViewData["Title"] = "Membership Plans";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-white">Choose Your <span style="color: var(--gym-red);">Plan</span></h2>
        <div style="height: 3px; width: 80px; background: var(--gym-red); margin: 20px auto;"></div>
        <p class="text-white-50 fs-5">No hidden fees. Cancel anytime.</p>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var plan in Model)
        {
            var features = plan.Features.Split(',', StringSplitOptions.RemoveEmptyEntries);
            var isPro = plan.PlanName.ToLower().Contains("pro");

            <div class="col-md-4">
                <div class="card h-100 border-0 p-4 position-relative overflow-hidden" 
                     style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px; @(isPro ? "border: 2px solid var(--gym-red) !important; transform: scale(1.05);" : "")">
                    
                    @if (isPro)
                    {
                        <div class="position-absolute top-0 end-0 bg-danger text-white px-3 py-1 fw-bold" style="border-bottom-left-radius: 15px;">
                            POPULAR
                        </div>
                    }

                    <div class="card-body text-center d-flex flex-column">
                        <h3 class="fw-bold text-white mb-3">@plan.PlanName</h3>
                        <p class="text-white-50">@plan.Description</p>
                        
                        <div class="my-4">
                            <span class="display-4 fw-bold text-white">₹@plan.Price.ToString("0")</span>
                            <span class="text-white-50">/ @plan.DurationMonths mo</span>
                        </div>

                        <ul class="list-unstyled text-start mb-4 flex-grow-1">
                            @foreach(var feature in features)
                            {
                                <li class="mb-3 text-white">
                                    <i class="fas fa-check-circle me-2" style="color: var(--gym-red);"></i> @feature
                                </li>
                            }
                        </ul>

                        <a asp-action="Subscribe" asp-route-id="@plan.MembershipPlanId" class="btn @(isPro ? "btn-gym" : "btn-outline-light") w-100 fw-bold py-2 mt-auto">
                            Choose @plan.PlanName
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
