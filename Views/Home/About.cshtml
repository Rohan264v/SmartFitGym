@{
    ViewData["Title"] = "About Us";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-white">About <span style="color: var(--gym-red);">SmartFit</span></h2>
        <div style="height: 3px; width: 80px; background: var(--gym-red); margin: 20px auto;"></div>
    </div>

    <div class="row align-items-center mb-5">
        <div class="col-md-6 mb-4 mb-md-0">
            <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&w=1470&auto=format&fit=crop" alt="Gym Interior" class="img-fluid rounded-4 shadow-lg" />
        </div>
        <div class="col-md-6 px-md-5">
            <h3 class="fw-bold text-white mb-3">Our Mission</h3>
            <p class="text-white-50 fs-5 mb-4">
                At SmartFit, we believe that fitness should be intelligent, personalized, and accessible. 
                We combine state-of-the-art gym facilities with advanced AI technology to provide you with the most effective workout experience possible.
            </p>
            <p class="text-white-50 fs-5">
                Whether you're a beginner looking for guidance or an experienced athlete aiming for new personal records, our AI-powered systems and expert trainers are here to support your journey every step of the way.
            </p>
        </div>
    </div>

    <div class="row text-center mt-5">
        <div class="col-md-4 mb-4">
            <h1 class="display-4 fw-bold" style="color: var(--gym-red);">5k+</h1>
            <h4 class="text-white">Active Members</h4>
        </div>
        <div class="col-md-4 mb-4">
            <h1 class="display-4 fw-bold" style="color: var(--gym-red);">50+</h1>
            <h4 class="text-white">Expert Trainers</h4>
        </div>
        <div class="col-md-4 mb-4">
            <h1 class="display-4 fw-bold" style="color: var(--gym-red);">24/7</h1>
            <h4 class="text-white">Gym Access</h4>
        </div>
    </div>
</div>
