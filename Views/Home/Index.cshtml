@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="container-fluid p-0 mb-5">
    <div class="position-relative w-100" style="height: 80vh; overflow: hidden; display: flex; align-items: center; justify-content: center;">
        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1470&auto=format&fit=crop" 
             style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.4);" alt="Gym Hero" />
        
        <div class="position-relative text-center text-white" style="z-index: 1;">
            <h1 class="display-3 fw-bold mb-3 text-uppercase" style="letter-spacing: 2px;">Transform Your <span style="color: var(--gym-red);">Body</span></h1>
            <p class="lead mb-4 fs-4">Join the most advanced AI-powered gym in the city.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-gym btn-lg px-5 py-3 fs-5 rounded-pill shadow-lg">Start Your Journey Today</a>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-white">Why Choose <span style="color: var(--gym-red);">SmartFit?</span></h2>
        <div style="height: 3px; width: 80px; background: var(--gym-red); margin: 20px auto;"></div>
    </div>

    <div class="row g-4">
        <!-- Feature 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
                <div class="card-body text-center">
                    <div class="mb-4" style="font-size: 3rem; color: var(--gym-red);">
                        <i class="fas fa-robot"></i>
                    </div>
                    <h4 class="card-title text-white mb-3">AI Workout Plans</h4>
                    <p class="card-text text-white-50">Get personalized workout routines generated by advanced AI based on your goals, body type, and progress.</p>
                </div>
            </div>
        </div>
        
        <!-- Feature 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
                <div class="card-body text-center">
                    <div class="mb-4" style="font-size: 3rem; color: var(--gym-red);">
                        <i class="fas fa-dumbbell"></i>
                    </div>
                    <h4 class="card-title text-white mb-3">Premium Equipment</h4>
                    <p class="card-text text-white-50">Train with state-of-the-art machines and free weights imported from top fitness brands worldwide.</p>
                </div>
            </div>
        </div>

        <!-- Feature 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
                <div class="card-body text-center">
                    <div class="mb-4" style="font-size: 3rem; color: var(--gym-red);">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h4 class="card-title text-white mb-3">Progress Tracking</h4>
                    <p class="card-text text-white-50">Log your workouts, monitor your BMI, and see your fitness journey visualized on your member dashboard.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="container-fluid my-5 py-5" style="background: linear-gradient(135deg, #e94560, #a01e36);">
    <div class="container text-center">
        <h2 class="text-white fw-bold mb-4">Ready to push your limits?</h2>
        <p class="text-white-50 fs-5 mb-4">Sign up now and get your first week absolutely free. No credit card required.</p>
        <a asp-controller="Membership" asp-action="Index" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill fw-bold">View Membership Plans</a>
    </div>
</div>


