@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Manage Members";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">Manage Members</h2>
        <a asp-action="Index" class="btn btn-outline-light">Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success text-white border-0">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <div class="card border-0" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="background: transparent;">
                    <thead>
                        <tr>
                            <th class="ps-4 py-3">Member Details</th>
                            <th class="py-3">Contact</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var user = item.User as SmartFitGym.Models.ApplicationUser;
                            var profile = item.Profile as SmartFitGym.Models.MemberProfile;
                            var sub = item.Subscription as SmartFitGym.Models.Subscription;

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user text-white"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 text-white">@(profile?.FullName ?? user?.FullName)</h6>
                                            <small class="text-white-50">Joined @(user?.CreatedAt.ToShortDateString())</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="text-white">@user?.Email</div>
                                    <small class="text-white-50">@(profile?.Phone ?? "No phone")</small>
                                </td>
                                <td class="py-3">
                                    @if (sub != null)
                                    {
                                        <span class="badge bg-success">@sub.MembershipPlan?.PlanName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Plan</span>
                                    }
                                </td>
                                <td class="py-3 text-end pe-4">
                                    <form asp-action="DeleteMember" method="post" onsubmit="return confirm('Are you sure you want to delete this member?');">
                                        <input type="hidden" name="id" value="@user?.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-white-50">No members found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
