@{
    ViewData["Title"] = "Dashboard";
    var profile = ViewBag.Profile as SmartFitGym.Models.MemberProfile;
    var subscription = ViewBag.Subscription as SmartFitGym.Models.Subscription;
    var workouts = ViewBag.Workouts as List<SmartFitGym.Models.WorkoutLog>;
    double bmi = ViewBag.BMI ?? 0;
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">Welcome back, <span style="color: var(--gym-red);">@profile?.FullName</span>!</h2>
        <div>
            <a asp-controller="AI" asp-action="Recommend" class="btn btn-outline-info me-2"><i class="fas fa-robot me-2"></i>AI Coach</a>
            <a asp-action="LogWorkout" class="btn btn-gym"><i class="fas fa-plus me-2"></i>Log Workout</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success text-white border-0">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- BMI Widget -->
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4 text-center" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
                <h5 class="text-white-50 mb-3">Your BMI</h5>
                <div class="display-3 fw-bold @(bmi > 25 || bmi < 18.5 ? "text-warning" : "text-success") mb-2">
                    @bmi
                </div>
                <div class="text-white-50">
                    @if (bmi < 18.5) { <span>Underweight</span> }
                    else if (bmi >= 18.5 && bmi < 25) { <span class="text-success">Normal</span> }
                    else if (bmi >= 25 && bmi < 30) { <span class="text-warning">Overweight</span> }
                    else { <span class="text-danger">Obese</span> }
                </div>
            </div>
        </div>

        <!-- Subscription Widget -->
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
                <h5 class="text-white-50 mb-3">Active Plan</h5>
                @if (subscription != null)
                {
                    <h3 class="text-white fw-bold mb-2">@subscription.MembershipPlan?.PlanName</h3>
                    <p class="text-success mb-0"><i class="fas fa-check-circle me-2"></i>Active until @subscription.EndDate.ToShortDateString()</p>
                }
                else
                {
                    <h4 class="text-white mb-3">No Active Plan</h4>
                    <a asp-controller="Membership" asp-action="Index" class="btn btn-outline-gym btn-sm">Subscribe Now</a>
                }
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
                <h5 class="text-white-50 mb-3">This Month</h5>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-white">Workouts</span>
                    <span class="text-white fw-bold">@workouts?.Count</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-white">Calories</span>
                    <span class="text-white fw-bold">@(workouts?.Sum(w => w.CaloriesBurned) ?? 0) kcal</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Workouts -->
    <div class="card border-0" style="background: var(--gym-card); backdrop-filter: blur(10px); border-radius: 15px;">
        <div class="card-header border-0 bg-transparent p-4 d-flex justify-content-between align-items-center">
            <h5 class="text-white mb-0">Recent Workouts</h5>
            <a asp-action="Profile" class="btn btn-sm btn-outline-light">Edit Profile</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" style="background: transparent;">
                    <thead>
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Type</th>
                            <th>Duration</th>
                            <th>Calories</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (workouts != null && workouts.Any())
                        {
                            foreach (var w in workouts)
                            {
                                <tr>
                                    <td class="ps-4">@w.LoggedAt.ToShortDateString()</td>
                                    <td><span class="badge bg-danger">@w.WorkoutType</span></td>
                                    <td>@w.DurationMinutes min</td>
                                    <td>@w.CaloriesBurned kcal</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-white-50">No workouts logged yet. Start training!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
